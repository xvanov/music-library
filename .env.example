# Copy to .env (gitignored) and fill in. Never commit .env.

# -- Where tracks land -------------------------------------------------
# Direct mode (running ON the music server): write straight to the library.
# MLIB_MUSIC_DIR=/home/YOU/music-server/music

# Remote mode (running from a laptop): push over WebDAV instead.
# Use the tailnet IP; MagicDNS names may not resolve on every client.
MLIB_DAV_URL=http://TAILNET_IP:4534
MLIB_DAV_USER=admin
MLIB_DAV_PASS=CHANGEME

# -- Navidrome (for `mlib ls` / `mlib rm` / rescan / `mlib pod sync`) -----
# Podcast rotation reads play counts, which are per user: use the account
# Amperfy logs in with. Without MLIB_ND_PASS heard episodes are never removed.
# A played episode stays this many hours before it is deleted (default 6):
# Amperfy may report a play at the start or halfway through.
# MLIB_POD_GRACE_HOURS=6
MLIB_ND_URL=http://TAILNET_IP:4533
MLIB_ND_USER=YOUR_NAVIDROME_USER
MLIB_ND_PASS=CHANGEME

# -- Fetch defaults ----------------------------------------------------
MLIB_AUDIO_FORMAT=mp3
MLIB_AUDIO_QUALITY=192

# -- mlib check --------------------------------------------------------
# Whisper language (en, fr, ru, ...). Unset or "auto" detects it per file;
# a collection's own setting (`mlib catalog collection`) wins over this.
# MLIB_CHECK_LANG=auto

# -- YouTube bot check -------------------------------------------------
# If downloads fail with "Sign in to confirm you're not a bot", use a logged-in
# session: a cookies.txt export (keep it out of the repo), or a browser name
# (chrome/edge/firefox) - that browser must be closed while mlib runs.
# MLIB_COOKIES=C:/Users/YOU/youtube-cookies.txt
# MLIB_COOKIES_BROWSER=firefox
